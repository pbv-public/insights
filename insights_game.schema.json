{
  "$id": "/insights/game",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Various insights about the game.",
  "properties": {
    "game_stats": {
      "$ref": "/insights/game_stats",
      "description": "Contains statistics about the game as a whole.",
      "title": "Game Stats"
    },
    "highlights": {
      "items": {
        "description": "a section of the video that stands out",
        "else": {
          "else": {
            "else": {
              "else": {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "poach"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "rally_idx": {
                      "description": "which rally in the video this shot occurs (0-indexed)",
                      "minimum": 0,
                      "type": "integer"
                    },
                    "shot_idx": {
                      "description": "the shot number in the rally (0-indexed)",
                      "minimum": 0,
                      "type": "integer"
                    }
                  },
                  "required": [
                    "rally_idx",
                    "shot_idx"
                  ]
                }
              },
              "if": {
                "properties": {
                  "kind": {
                    "const": "long_rally"
                  }
                }
              },
              "then": {
                "properties": {
                  "rally_idx": {
                    "description": "which rally in the video this shot occurs (0-indexed)",
                    "minimum": 0,
                    "type": "integer"
                  }
                },
                "required": [
                  "rally_idx"
                ]
              }
            },
            "if": {
              "properties": {
                "kind": {
                  "const": "hands_battle"
                }
              }
            },
            "then": {
              "properties": {
                "rally_idx": {
                  "description": "which rally in the video this shot occurs (0-indexed)",
                  "minimum": 0,
                  "type": "integer"
                },
                "shot_end_idx": {
                  "description": "the final shot index in the range, inclusive (0-indexed)",
                  "minimum": 0,
                  "type": "integer"
                },
                "shot_start_idx": {
                  "description": "the shot index in which the initiating shot occurred (0-indexed)",
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "rally_idx",
                "shot_start_idx",
                "shot_end_idx"
              ]
            }
          },
          "if": {
            "properties": {
              "kind": {
                "const": "erne"
              }
            }
          },
          "then": {
            "properties": {
              "rally_idx": {
                "description": "which rally in the video this shot occurs (0-indexed)",
                "minimum": 0,
                "type": "integer"
              },
              "shot_idx": {
                "description": "the shot number in the rally (0-indexed)",
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "rally_idx",
              "shot_idx"
            ]
          }
        },
        "if": {
          "properties": {
            "kind": {
              "const": "atp"
            }
          }
        },
        "properties": {
          "e": {
            "$ref": "/types/video_time",
            "description": "when in the original video the highlight ends",
            "title": "Video Milliseconds"
          },
          "kind": {
            "enum": [
              "atp",
              "erne",
              "hands_battle",
              "long_rally",
              "poach"
            ],
            "type": "string"
          },
          "s": {
            "$ref": "/types/video_time",
            "description": "when in the original video the highlight starts",
            "title": "Video Milliseconds"
          },
          "score": {
            "$ref": "/types/quality_score",
            "description": "quality compared to other highlights of the _same kind_",
            "title": "Quality Score"
          }
        },
        "required": [
          "s",
          "e",
          "score",
          "kind"
        ],
        "then": {
          "properties": {
            "rally_idx": {
              "description": "which rally in the video this shot occurs (0-indexed)",
              "minimum": 0,
              "type": "integer"
            },
            "shot_idx": {
              "description": "the shot number in the rally (0-indexed)",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "rally_idx",
            "shot_idx"
          ]
        },
        "title": "Highlight",
        "type": "object",
        "unevaluatedProperties": false
      },
      "type": "array"
    },
    "player_stats": {
      "description": "each player's stats",
      "items": {
        "$ref": "/insights/player_stats",
        "description": "Contains player-specific stats over the whole game.",
        "title": "Player Stats"
      },
      "maxItems": 4,
      "minItems": 4,
      "type": "array"
    },
    "rallies": {
      "description": "An ordered list of the rallies within the game.",
      "items": {
        "$ref": "/events/rally",
        "title": "Rally"
      },
      "minItems": 1,
      "type": "array"
    },
    "version": {
      "$ref": "/types/version",
      "const": "0.0.14",
      "description": "a version string matching x.x.x where x represents one or more digits",
      "title": "Version"
    }
  },
  "required": [
    "version",
    "game_stats",
    "highlights",
    "player_stats",
    "rallies"
  ],
  "title": "Game Insights",
  "type": "object"
}